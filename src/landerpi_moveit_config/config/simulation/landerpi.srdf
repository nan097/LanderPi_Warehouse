<robot name="rosmentor">
    <group name="arm">
        <joint name="joint1" />
        <joint name="joint2" />
        <joint name="joint3" />
        <joint name="joint4" />
        <joint name="joint5" />
        <joint name="end_effector_joint" />
    </group>
    <group name="gripper">
        <joint name="left_jaw_joint" />
        <joint name="right_jaw_joint" />
        <joint name="r_joint" />
        <joint name="gripper_left_join" />
        <joint name="gripper_right_joint" />
    </group>
    <group_state name="home" group="arm">
        <joint name="joint1" value="0" />
        <joint name="joint2" value="0" />
        <joint name="joint3" value="0" />
        <joint name="joint4" value="0" />
        <joint name="joint5" value="0" />
    </group_state>
    <group_state name="transport" group="arm">
        <joint name="joint1" value="0" />
        <joint name="joint2" value="0" />
        <joint name="joint3" value="0" />
        <joint name="joint4" value="0" />
        <joint name="joint5" value="0" />
    </group_state>
    <group_state name="open" group="gripper">
        <joint name="r_joint" value="0" />
    </group_state>
    <group_state name="close" group="gripper">
        <joint name="r_joint" value="-0.5" />
    </group_state>
    <end_effector name="gripper" parent_link="end_effector_link" group="gripper" />
    <disable_collisions link1="back_shell_black_link" link2="back_shell_middle_link" reason="Adjacent" />
