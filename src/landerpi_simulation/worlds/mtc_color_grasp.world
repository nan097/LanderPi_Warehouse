              <size>0.04 0.04 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="box">
          <geometry>
            <box>
              <size>0.04 0.04 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.8 0.02 0.02 1</ambient>
            <diffuse>0.8 0.02 0.02 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="cargo_green">
      <pose>0.64 -0.07 0.025 0 0 0</pose>
      <link name="box">
        <inertial>
          <mass>0.05</mass>
          <inertia>
            <ixx>0.00002</ixx>
            <iyy>0.00002</iyy>
            <izz>0.00002</izz>
          </inertia>
        </inertial>
        <collision name="box">
          <geometry>
            <box>
              <size>0.04 0.04 0.05</size>
            </box>
          </geometry>
        </collision>
        <visual name="box">
          <geometry>
            <box>
              <size>0.04 0.04 0.05</size>
            </box>
          </geometry>
          <material>
            <ambient>0.02 0.8 0.02 1</ambient>
            <diffuse>0.02 0.8 0.02 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
      </link>
    </model>
    <model name="cargo_blue">
      <pose>0.64 0.07 0.025 0 0 0</pose>
      <link name="box">
        <inertial>
