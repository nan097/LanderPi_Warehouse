<?xml version="1.0"?>
<sdf version="1.6"><world name="sorting">
  <plugin name="state" filename="libgazebo_ros_state.so"><ros><namespace>/gazebo</namespace></ros><update_rate>20</update_rate></plugin>
  <gui><camera name="user_camera"><pose>2 -2.5 1.8 0 0.5 2.1</pose><view_controller>orbit</view_controller></camera></gui>
  <physics type="ode" name="physics"><max_step_size>0.001</max_step_size><real_time_update_rate>1000</real_time_update_rate></physics>
  <light name="sun" type="directional"><pose>0 0 10 0 0 0</pose><diffuse>0.8 0.8 0.8 1</diffuse><direction>-0.5 0.1 -0.9</direction></light>
  <model name="ground"><static>true</static><link name="ground">
    <collision name="ground"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
    <visual name="ground"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry><material><ambient>0.7 0.7 0.7 1</ambient></material></visual>
  </link></model>
  <model name="pick_table"><static>true</static><pose>0.75 0 0.08 0 0 0</pose><link name="table">
    <collision name="table"><geometry><box><size>0.30 0.40 0.16</size></box></geometry></collision>
    <visual name="table"><geometry><box><size>0.30 0.40 0.16</size></box></geometry><material><ambient>0.4 0.3 0.2 1</ambient></material></visual>
  </link></model>
  <model name="place_table"><static>true</static><pose>0.75 1.5 0.08 0 0 0</pose><link name="table">
    <collision name="table"><geometry><box><size>0.30 0.40 0.16</size></box></geometry></collision>
    <visual name="table"><geometry><box><size>0.30 0.40 0.16</size></box></geometry><material><ambient>0.2 0.4 0.3 1</ambient></material></visual>
  </link></model>
  <model name="box"><pose>0.67 0 0.185 0 0 0</pose><link name="box">
    <inertial><mass>0.05</mass><inertia><ixx>0.00002</ixx><iyy>0.00002</iyy><izz>0.00002</izz></inertia></inertial>
    <collision name="box"><geometry><box><size>0.04 0.04 0.05</size></box></geometry></collision>
    <visual name="box"><geometry><box><size>0.04 0.04 0.05</size></box></geometry><material><ambient>0.4 0.02 0.02 1</ambient><diffuse>0.8 0.02 0.02 1</diffuse><specular>0 0 0 1</specular></material></visual>
  </link></model>
<model name="overhead_camera"><static>true</static><pose>0.75 0 1 0 1.57079632679 0</pose><link name="camera">
 <sensor name="rgbd" type="depth"><always_on>true</always_on><update_rate>5</update_rate><visualize>false</visualize>
 <camera><horizontal_fov>1.047</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.05</near><far>3</far></clip></camera>
 <plugin name="rgbd" filename="libgazebo_ros_camera.so"><ros><namespace>/camera</namespace></ros><camera_name>camera</camera_name><frame_name>camera_optical_frame</frame_name></plugin></sensor>
 </link></model>
</world></sdf>
